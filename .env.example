BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here
# Vote webhooks (optional) — grant Shards on upvote
TOPGG_WEBHOOK_SECRET=your_topgg_webhook_secret   # top.gg → POST /topgg/vote (X-topgg-signature)
DBL_WEBHOOK_SECRET=your_discordbotlist_secret    # discordbotlist → POST /dbl/vote (Authorization header)
# discordbotlist.com API token (bot edit page → API). Only needed to run
# `npm run sync-dbl`, which submits the slash-command list to DBL.
DBL_API_TOKEN=your_discordbotlist_api_token
